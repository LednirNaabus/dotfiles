configuration {
    display-drun: "Applications";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font Mono 12";
    modi: "window,run,drun";
    show-icons: false;
    fixed-num-lines: false;
}

@import "colors"

scrollbar {
    width: 0;
    handle-width: 0;
}

window {
    fullscreen: true;
    background-color: @black;
    border: 0;
    padding: 38% 40% 25% 40%;
    children: [mainbox];
}

mainbox {
    y-offset: 0%;
    location: center;
    anchor: north;
    spacing: 3;
    background-color: @transparent;
    border: 0;
    transparency: "real";
    children: [inputbar, listview];
}

inputbar {
    background-color: @bg;
    text-color: @fg;
    children: [prompt, entry];
}

prompt {
    background-color: @bg;
    text-color: @green;
    padding: 0.5em;
    border: 0;
}

entry {
    background-color: @bg;
    text-color: @fg;
    placeholder: "";
    padding: 0.5em 0;
    border: 0;
}

listview {
    background-color: @transparent;
    cycle: false;
    dynamic: true;
    padding: 0;
    border: 0;
    columns: 1;
    spacing: 2;
    children: [element];
}

element {
    padding: 0;
    border: 0;
}

element selected {
    background-color: @transparent;
    text-color: @fg;
    border: 0;
}

element-text {
    background-color: @bg;
    text-color: @fg;
    padding: 0.3em 0.4em;
    border: 0;
}

element-text selected {
    background-color: @selected;
    text-color: @green;
    padding: 0.3em 0.4em;
    border: 0;
}
